# AI Video Clipper Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Hardware Acceleration
# Options: auto, cuda, cpu
DEVICE=auto
COMPUTE_TYPE=auto

# Whisper Model Configuration
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# Output Defaults
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
FPS=30

# Optional API keys (for advanced LLM analysis if desired, local heuristic works 100% offline)
OPENAI_API_KEY=
GROQ_API_KEY=

